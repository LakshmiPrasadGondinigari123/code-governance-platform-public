# Copy to .env for local runs. Never commit real values.

# --- Required for production -------------------------------------------------
SECRET_KEY=change-me-to-a-long-random-string      # JWT signing key (auto-generated and stored if unset)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-now                      # if unset, a random password is generated and printed once in the logs

# --- Storage -----------------------------------------------------------------
DATA_DIR=./data                                   # SQLite DB + scan workdirs. Mount a Railway volume at /data

# --- Optional: AI explanations (Groq) ----------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Optional: SSO (OIDC) ----------------------------------------------------
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://YOUR-APP/auth/sso/callback
OIDC_PROVIDER_NAME=SSO
OIDC_DEFAULT_ROLE=viewer

# --- Optional: exports -------------------------------------------------------
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
WEBHOOK_EXPORT_URL=

# --- Tuning ------------------------------------------------------------------
MAX_CONCURRENT_SCANS=2
TOKEN_TTL_SECONDS=28800
CORS_ORIGINS=*
LOG_LEVEL=INFO
